# ==============================================================================
# TeleStremio (weebzone/Telegram-Stremio) Configuration
# Copy/edit at: /home/ubuntu/telegram-stremio/config.env
# ==============================================================================

# Telegram API credentials from https://my.telegram.org
API_ID=""
API_HASH=""

# Telegram Bot token from @BotFather (make sure the bot is admin in your channels)
BOT_TOKEN=""

# Your numeric Telegram user ID (get from @userinfobot)
OWNER_ID=""

# MongoDB connection URIs (REQUIRED: comma-separated, at least 2 URIs: tracking,storage_1)
# Example: DATABASE="mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/tracking?retryWrites=true&w=majority,mongodb+srv://user:pass@cluster0.xxxx.mongodb.net/storage1?retryWrites=true&w=majority"
DATABASE=""

# HTTP server port (default: 8000)
PORT="8000"
