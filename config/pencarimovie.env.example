# ==============================================================================
# PencariMovie Server (aiskendi/pencarimovie-server) Configuration
# Installed to: /home/ubuntu/pencarimovie/.env
# ==============================================================================

# HTTP listening host & port
PM_LISTEN_HOST=0.0.0.0
PORT=8088

# Persistent storage directory (sessions, auth, caches)
PM_APP_ROOT=/home/ubuntu/pencarimovie/storage

# Remote Access & Security
# Dashboard password when accessed from public IP / HTTPS domain (change this!)
SERVER_PASSWORD=changeme_secure_password

# Permanent token for Stremio / Nuvio manifest URL:
# https://pm.<your-domain>/<SERVER_TOKEN>/manifest.json
# (install.sh generates a random 32-char hex token automatically on first install)
SERVER_TOKEN=66ff097863dedb7ccd8401d5ffe616f2

# Optional: Custom Telegram Bot API Token or comma-separated pool
# BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# BOT_TOKENS=111111111:AAA...,222222222:BBB...

# Optional: Cloudflare Zero Trust Named Tunnel Token
# TUNNEL_TOKEN=

# Optional: Streaming concurrency tuning (0 = auto/unlimited)
PM_INFLIGHT=0
PM_MAX_STREAMS=0
PM_PIPELINE=0
